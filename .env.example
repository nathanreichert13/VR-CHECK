# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Sem essas variáveis o sistema roda em "modo local",
# salvando tudo apenas no navegador deste aparelho.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sua-chave-publica-anon-ou-publishable
